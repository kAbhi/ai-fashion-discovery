# ---------------------------------------------------------------------------
# Local development environment file (copy to .env for local use)
# NEVER commit secrets. This file is a template only.
# ---------------------------------------------------------------------------

# --- Application -------------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- PostgreSQL (local via Docker Compose or Homebrew) -----------------------
# Render production uses its own DATABASE_URL; this is local-only.
DATABASE_URL=postgresql+psycopg://fashion:fashion@localhost:5432/fashion_discovery
TEST_DATABASE_URL=postgresql+psycopg://fashion:fashion@localhost:5432/fashion_discovery_test
POSTGRES_USER=fashion
POSTGRES_PASSWORD=fashion
POSTGRES_DB=fashion_discovery
POSTGRES_PORT=5432

# --- CORS -------------------------------------------------------------------
# Render production sets this to the Vercel frontend domain.
# Local development: http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Optional regex for preview backends that cannot be listed exactly
# (e.g. Vercel Preview URLs). Leave unset in production.
# CORS_ORIGIN_REGEX=https://fashion-discovery-[a-z0-9-]+\.vercel\.app

# --- LLM (backend only; never expose to frontend) ---------------------------
# Provider name used for structured intent extraction (from Phase 2 onward).
# LLM_PROVIDER=openai
# LLM_API_KEY=<set in your dashboard, never here>

# --- Frontend (browser-visible; prefixed NEXT_PUBLIC_) ----------------------
# Used by the browser to call the backend. Must be set per environment:
#   local  -> http://localhost:8000
#   preview-> https://<preview-backend>.onrender.com
#   prod   -> https://<backend>.onrender.com
# Leave empty in .env.local to force a configuration error rather than a silent
# wrong-host call (checked at runtime in lib/config.ts).
NEXT_PUBLIC_API_BASE_URL=
